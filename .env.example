PORT=5000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pondsense
MYSQL_SSL=false
FRONTEND_URL=http://localhost:5173
IPROG_SMS_API_TOKEN=your-iprog-token-here
IPROG_SMS_PROVIDER=0
# Enable only after expert review of the water-alert rules; record the review reference.
WATER_SMS_THRESHOLDS_REVIEWED=false
WATER_SMS_RULES_REFERENCE=
SENSOR_API_KEY=change-this-device-secret
SENSOR_DEVICE_NAME=ESP32 PondSense Device
SENSOR_OWNER_PHONE=+639000000000
# Generate at least 32 random characters; production refuses a missing/weak secret.
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pondsense.local
ADMIN_PHONE=+639000000000
# Required only for initial provisioning; existing database credentials are preserved.
ADMIN_PASSWORD=
ADMIN_PIN=
# Phase 2: stable browser origin/RP domain. Do not use preview deployment domains.
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
# Operator supplies this only for first enrollment; remove after successful enrollment.
ADMIN_WEBAUTHN_BOOTSTRAP_SECRET=
# Set only if multiple historic admin rows exist; selects one without deleting them.
ADMIN_ACCOUNT_ID=
